DISCORD_TOKEN=your_discord_bot_token
# Paste the Neon pooled PostgreSQL connection string here.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/DBNAME?sslmode=require
# DATABASE_URL is accepted as a fallback if you prefer that variable name.
# DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=10
BOT_PREFIX=!
MARKET_TAX_PERCENT=5
